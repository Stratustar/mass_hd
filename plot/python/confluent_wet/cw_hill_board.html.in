<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Hill-law tau_m scan</title>
<style>
:root{color-scheme:light;--ink:#26343d;--muted:#718089;--line:#dfe5e7;--bg:#f7f8f8;--ca:#d9737d;--cp:#3f9fb0;--legacy:#9aa3ab}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
main{max-width:1180px;margin:auto;padding:22px 24px 36px}
h1{font-size:19px;font-weight:600;margin:0 0 4px}.parameters{display:flex;gap:22px;flex-wrap:wrap;margin-bottom:12px;font-size:15px;color:var(--muted);font-variant-numeric:tabular-nums}.parameters b{color:var(--ink);font-weight:500}
#summary{display:block;width:100%;height:auto;background:white;border:1px solid var(--line);border-radius:7px;margin-bottom:14px}
#summary .pt{cursor:pointer}
header{position:sticky;top:0;z-index:5;padding:12px 14px;background:#fafcfbf5;border:1px solid var(--line);border-radius:9px;backdrop-filter:blur(12px)}
.row{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.row+.row{margin-top:9px}.label{color:var(--muted);margin-right:3px}.choices{display:inline-flex;gap:5px;flex-wrap:wrap}
button,select{font:inherit;color:var(--ink);background:white;border:1px solid var(--line);border-radius:6px;padding:5px 10px;cursor:pointer}button:hover,select:hover{border-color:#9bb8bf}button[aria-pressed=true]{border-color:#86b9c2;background:#e8f2f4}button:focus-visible,select:focus-visible,input:focus-visible{outline:2px solid #8C6BB1;outline-offset:2px}
#play{min-width:63px;color:white;background:#304851;border-color:#304851}#seek{flex:1;min-width:160px;accent-color:#557f8c}#clock{min-width:145px;text-align:right;font-variant-numeric:tabular-nums}#notice{color:#9b4248;font-size:12px;margin-top:8px}#notice:empty{display:none}
#cards{display:grid;gap:14px;margin-top:16px}#cards.grid{grid-template-columns:auto repeat(var(--n),1fr);gap:6px;align-items:center}
article{overflow:hidden;border:1px solid var(--line);border-top:3px solid var(--case);border-radius:7px;background:white}.caption{padding:6px 12px;font-size:13px;display:flex;gap:12px;flex-wrap:wrap}.caption .stat{color:var(--muted);font-variant-numeric:tabular-nums}.caption .flag{color:#9b4248}
video{display:block;width:100%;background:#101318}
.crop{position:relative;overflow:hidden;aspect-ratio:1;border-radius:4px;background:#101318;border-bottom:3px solid var(--case);cursor:pointer}
.crop video{position:absolute;width:var(--w);left:var(--l);top:var(--t);max-width:none}
.colhead,.rowhead{font-size:12px;color:var(--muted);text-align:center;font-variant-numeric:tabular-nums}.rowhead{writing-mode:vertical-rl;transform:rotate(180deg);padding:0 2px}
.colhead button{padding:2px 6px;font-size:12px}
#trace{display:block;width:100%;height:auto;margin-top:18px;background:white;border-radius:7px;border:1px solid var(--line);cursor:crosshair}
.note{color:var(--muted);font-size:12px;margin-top:10px}
@media(max-width:650px){main{padding:14px 10px 24px}header{padding:9px}#clock{min-width:120px;font-size:12px}button,select{padding:5px 8px}}
</style>
</head>
<body><main>
<h1>Hill response law: τ<sub>m</sub> scan</h1>
<div class="parameters"><span>n<sub>1</sub> = <b id="hn"></b></span><span>w<sub>p</sub> = <b id="wp"></b></span><span>β = <b id="beta"></b></span><span>τ<sub>χ</sub> = <b id="tchi"></b></span><span>m<sub>c</sub> = <b id="mc"></b></span><span>L = <b id="size"></b></span><span>one seed</span><span><b>χ = 1 active</b></span></div>
<svg id="summary" viewBox="0 0 1100 286" role="img" aria-label="Late-time active fraction and memory versus tau_m, with the legacy step law"></svg>
<header>
<div class="row"><span class="label">View</span><div class="choices" role="group" aria-label="View"><button id="view-single">Single τ<sub>m</sub> (u, P, m, χ)</button><button id="view-grid">All τ<sub>m</sub> (χ only)</button></div><span class="label" style="margin-left:14px">Trace</span><select id="field" aria-label="Trace quantity"><option value="chi">⟨χ⟩ active fraction</option><option value="memory">⟨m⟩ memory</option></select></div>
<div class="row" id="tm-row"><span class="label">τ<sub>m</sub>/τ<sub>c</sub></span><div id="tms" class="choices" role="group" aria-label="Memory time"></div></div>
<div class="row"><button id="play">Play</button><button id="reset" aria-label="Restart">↺</button><input id="seek" type="range" min="0" max="1" step="any" value="0" aria-label="Time after release"><span id="clock">t / τc = —</span><select id="speed" aria-label="Playback speed"><option value="0.5">0.5×</option><option value="1" selected>1×</option><option value="2">2×</option><option value="4">4×</option><option value="8">8×</option></select><label><input type="checkbox" id="prep"> show preparation</label><button id="fullscreen" aria-label="Full screen">⛶</button></div>
<div id="notice" role="status"></div>
</header>
<div id="cards"></div>
<svg id="trace" viewBox="0 0 1100 270" role="img" aria-label="Mean field versus time after release"></svg>
<p class="note">All movies share one clock, t/τ<sub>c</sub> after release of the χ reaction. The preparation (χ reaction off) lasts max(100 τ<sub>c</sub>, 10 τ<sub>m</sub>), so with “show preparation” on, runs with a shorter preparation hold their first frame until their own start. Grey on the summary: the legacy step-law partner runs (20260911, rep 1), drawn as 1 − ⟨χ<sub>legacy</sub>⟩ with their starts relabelled. Click a point, a column header or a χ tile to open that τ<sub>m</sub>; click the trace to seek.</p>
</main>
<script type="application/json" id="data">__DATA__</script>
<script>
(()=>{'use strict';
const $=id=>document.getElementById(id);
try {
  const data=JSON.parse($('data').textContent), tc=data.tau_c, P=data.panel;
  const grid=[...new Set(data.runs.map(r=>r.tm_over_tc))].sort((a,b)=>a-b);
  const STARTS=['1','0'], NAME={'1':'active start (χ₀ = 1)','0':'passive start (χ₀ = 0)'};
  const css=getComputedStyle(document.documentElement), colors={'1':css.getPropertyValue('--ca').trim(),'0':css.getPropertyValue('--cp').trim()}, grey=css.getPropertyValue('--legacy').trim();
  const viridis=['#440154','#443983','#31688e','#21918c','#35b779','#90d743','#fde725'];
  const tcolor=k=>viridis[Math.round(k*(viridis.length-1)/Math.max(grid.length-1,1))];
  const fmt=x=>String(Number(x.toFixed(3)));
  const run=(g,st)=>data.runs.find(r=>r.tm_over_tc===g&&r.initialization===st);
  let view='single', gi=grid.findIndex(g=>Math.abs(g-8.684)<.01), entries=[], playing=false, rate=1, position=0, startTime=0, endTime=0, timer;
  if(gi<0)gi=Math.floor(grid.length/2);
  // Movie time of release-clock t: each run has its own preparation, hence its own offset.
  const timeOf=(r,i)=>(i*r.frame_steps-r.preparation_steps)/tc;
  const mediaRaw=(r,t)=>(r.preparation_steps+t*tc)/(r.frame_steps*r.fps);
  const report=m=>{$('notice').textContent=m;};
  const shownRuns=()=>view==='single'?STARTS.map(st=>run(grid[gi],st)).filter(Boolean):data.runs;
  const lo=()=>$('prep').checked?Math.min(...shownRuns().map(r=>-r.preparation_steps/tc)):0;
  const hi=()=>Math.min(...shownRuns().map(r=>timeOf(r,r.frames-1)));
  const tx=t=>64+1010*(t-lo())/(hi()-lo());
  // One JS clock is the only time base; every video chases it (rate nudges for small drift,
  // seeks for large drift, re-issued seeks when a byte-range fetch stalls).
  let wall0=0, pos0=0;
  const now=()=>playing?pos0+(performance.now()-wall0)/1000*rate*data.tc_per_second:position;
  function stamp(){
    if(!entries.length)return;
    $('seek').value=position;$('clock').textContent=`t / τc = ${position.toFixed(1)}`;
    const c=$('cursor');if(c){const x=tx(position);c.setAttribute('x1',x);c.setAttribute('x2',x);}
  }
  function seekVideo(e,target){e.v.currentTime=target;e.seekAt=performance.now();}
  function sync(){
    for(const e of entries){
      const v=e.v;if(v.readyState<1)continue;
      const raw=mediaRaw(e.r,position), held=raw<0||raw>v.duration-.02;
      const target=Math.max(0,Math.min(v.duration-.02,raw));
      if(v.seeking){if(performance.now()-(e.seekAt||0)>1500)seekVideo(e,target);continue;}
      const drift=v.currentTime-target;
      if(!playing||held){if(!v.paused)v.pause();if(Math.abs(drift)>.02)seekVideo(e,target);continue;}
      if(Math.abs(drift)>.35){seekVideo(e,target);continue;}
      v.playbackRate=rate*(1-Math.max(-.25,Math.min(.25,drift)));
      if(v.paused&&v.readyState>=2&&!v.ended)v.play().catch(()=>{});
    }
  }
  function stop(){position=Math.max(startTime,Math.min(endTime,now()));playing=false;$('play').textContent='Play';for(const e of entries)e.v.pause();sync();stamp();}
  function seekTo(t){position=Math.max(startTime,Math.min(endTime,t));if(playing){pos0=position;wall0=performance.now();}sync();stamp();}
  function play(){
    if(!entries.length)return;
    if(position>=endTime-1e-6)position=startTime;
    pos0=position;wall0=performance.now();playing=true;$('play').textContent='Pause';report('');
    for(const e of entries)e.v.playbackRate=rate;
    sync();
  }
  function summary(){
    // Two linear-x panels: late active fraction and late memory against tau_m. Coloured: this
    // scan; grey dashed: the legacy step-law partner runs.
    const W=470, H=190, ox=[64,600], oy=50, xmax=Math.ceil((grid[grid.length-1]+.5)/2)*2;
    const px=(o,x)=>o+W*x/xmax;
    const mv=[...data.runs.map(r=>r.tail_m),...data.legacy.map(r=>r.tail_m),data.mc];
    const panels=[{key:'tail_mean',lkey:'tail_active_fraction',label:'late-time active fraction ⟨χ⟩',lo:0,hi:1,dv:.2},
                  {key:'tail_m',lkey:'tail_m',label:'late-time ⟨m⟩   (dashed: m_c)',lo:Math.max(0,Math.floor(Math.min(...mv)*20-.5)/20),hi:Math.ceil(Math.max(...mv)*20+.5)/20,dv:.05}];
    let s='';
    panels.forEach((p,j)=>{
      const o=ox[j], py=v=>oy+H*(1-(v-p.lo)/(p.hi-p.lo));
      s+=`<path d="M${o} ${oy}V${oy+H}H${o+W}" fill="none" stroke="#a5b0b6"/>`;
      for(let k=Math.ceil(p.lo/p.dv-1e-9);k*p.dv<=p.hi+1e-9;k++){const v=k*p.dv,y=py(v);s+=`<path d="M${o-5} ${y}H${o}" stroke="#a5b0b6"/><text x="${o-8}" y="${y+4}" text-anchor="end" fill="#677781" font-size="11">${fmt(v)}</text>`;}
      for(let x=0;x<=xmax;x+=2){const xx=px(o,x);s+=`<path d="M${xx} ${oy+H}V${oy+H+5}" stroke="#a5b0b6"/><text x="${xx}" y="${oy+H+18}" text-anchor="middle" fill="#677781" font-size="11">${x}</text>`;}
      s+=`<text x="${o+W/2}" y="${oy+H+36}" text-anchor="middle" fill="#45565f" font-size="12">τm / τc</text><text x="${o+2}" y="${oy-12}" fill="#45565f" font-size="13">${p.label}</text>`;
      if(view==='single'){const x=px(o,grid[gi]);s+=`<rect x="${x-9}" y="${oy}" width="18" height="${H}" fill="#e8f2f4"/>`;}
      if(j===1){const y=py(data.mc);s+=`<path d="M${o} ${y}H${o+W}" stroke="#52636d" stroke-dasharray="3 4"/>`;}
      for(const st of STARTS){
        const lg=data.legacy.filter(r=>r.initialization===st).sort((a,b)=>a.tm_over_tc-b.tm_over_tc);
        if(lg.length)s+=`<polyline points="${lg.map(r=>`${px(o,r.tm_over_tc).toFixed(1)},${py(r[p.lkey]).toFixed(1)}`).join(' ')}" fill="none" stroke="${grey}" stroke-width="1.1" stroke-dasharray="4 3"/>`+
          lg.map(r=>`<circle cx="${px(o,r.tm_over_tc).toFixed(1)}" cy="${py(r[p.lkey]).toFixed(1)}" r="2.2" fill="${grey}"><title>legacy τm=${fmt(r.tm_over_tc)}, ${NAME[st]}: ${r[p.lkey].toFixed(3)}</title></circle>`).join('');
        const rr=data.runs.filter(r=>r.initialization===st).sort((a,b)=>a.tm_over_tc-b.tm_over_tc);
        s+=`<polyline points="${rr.map(r=>`${px(o,r.tm_over_tc).toFixed(1)},${py(r[p.key]).toFixed(1)}`).join(' ')}" fill="none" stroke="${colors[st]}" stroke-width="1.8"/>`;
        for(const r of rr){const x=px(o,r.tm_over_tc),y=py(r[p.key]),t=`<title>τm=${fmt(r.tm_over_tc)}, ${NAME[st]}: ${r[p.key].toFixed(4)}</title>`,g=grid.indexOf(r.tm_over_tc);
          s+=st==='1'?`<circle class="pt" data-g="${g}" cx="${x}" cy="${y}" r="5.5" fill="${colors[st]}">${t}</circle>`
                     :`<rect class="pt" data-g="${g}" x="${x-4.5}" y="${y-4.5}" width="9" height="9" fill="white" stroke="${colors[st]}" stroke-width="2">${t}</rect>`;}
      }
    });
    s+=`<circle cx="620" cy="12" r="5" fill="${colors['1']}"/><text x="630" y="16" font-size="12" fill="#45565f">active start (χ₀ = 1)</text><rect x="768" y="7" width="9" height="9" fill="white" stroke="${colors['0']}" stroke-width="2"/><text x="782" y="16" font-size="12" fill="#45565f">passive start (χ₀ = 0)</text><path d="M915 12H935" stroke="${grey}" stroke-dasharray="4 3"/><text x="940" y="16" font-size="12" fill="#45565f">legacy step law</text>`;
    $('summary').innerHTML=s;
    $('summary').querySelectorAll('.pt').forEach(el=>el.onclick=()=>{gi=+el.dataset.g;view='single';render();});
  }
  function trace(){
    const f=$('field').value, a=lo(), ymax=f==='chi'?1:.4, py=v=>216-v/ymax*198;
    let s='<path d="M64 18V216H1074" fill="none" stroke="#a5b0b6"/>';
    for(let k=0;k<=4;k++){const v=k*ymax/4,yy=py(v);s+=`<path d="M59 ${yy}H64" stroke="#a5b0b6"/><text x="52" y="${yy+4}" text-anchor="end" fill="#677781" font-size="12">${fmt(v)}</text>`;}
    const b=hi(), ticks=[...(a<0?[a]:[]),...[0,1,2,3,4].map(k=>k*b/4)];
    for(const t of ticks){const x=tx(t);s+=`<path d="M${x} 216V221" stroke="#a5b0b6"/><text x="${x}" y="236" text-anchor="middle" fill="#677781" font-size="12">${Math.round(t)}</text>`;}
    if(f==='memory'){const y=py(data.mc);s+=`<path d="M64 ${y}H1074" stroke="#52636d" stroke-dasharray="3 4"/><text x="1070" y="${y-5}" text-anchor="end" fill="#52636d" font-size="11">m_c</text>`;}
    for(const r of shownRuns()){
      const pts=[];for(let i=0;i<r.frames;i++){const t=timeOf(r,i);if(t<a-1e-9||t>b+1e-9)continue;pts.push(`${tx(t).toFixed(1)},${py(r[f][i]).toFixed(1)}`);}
      const col=view==='single'?colors[r.initialization]:tcolor(grid.indexOf(r.tm_over_tc));
      s+=`<polyline points="${pts.join(' ')}" fill="none" stroke="${col}" stroke-width="1.3" ${r.initialization==='0'?'stroke-dasharray="5 3"':''}/>`;
    }
    if(view==='grid')grid.forEach((g,k)=>{s+=`<text x="${1074-(grid.length-1-k)*48}" y="14" text-anchor="end" font-size="12" fill="${tcolor(k)}">${fmt(g)}</text>`;});
    const lab=f==='chi'?'⟨χ⟩':'⟨m⟩';
    s+=`<text x="569" y="258" text-anchor="middle" fill="#45565f" font-size="13">t / τc after release${view==='grid'?'   (colour: τm/τc; dashed: passive start)':'   (dashed: passive start)'}</text><text x="18" y="117" text-anchor="middle" transform="rotate(-90 18 117)" fill="#45565f" font-size="14">${lab}</text><line id="cursor" x1="64" x2="64" y1="18" y2="216" stroke="#52636d" stroke-dasharray="4 4"/>`;
    $('trace').innerHTML=s;stamp();
  }
  function addVideo(r,parent,label){
    const v=document.createElement('video');v.muted=true;v.playsInline=true;v.preload='auto';v.poster=r.poster;v.src=r.url;
    v.setAttribute('aria-label',label);parent.append(v);
    const e={r,v};entries.push(e);
    v.addEventListener('loadedmetadata',()=>{if(!entries.includes(e))return;
      if(v.videoWidth!==r.width||v.videoHeight!==r.height||Math.abs(v.duration-r.duration)>.1){stop();report('Video metadata mismatch: '+r.url);return;}
      sync();});
    v.addEventListener('error',()=>{if(entries.includes(e))report('Unable to load video: '+r.url);});
    return v;
  }
  function bounds(){startTime=lo();endTime=hi();$('seek').min=startTime;$('seek').max=endTime;}
  function render(){
    const old=position;stop();
    for(const e of entries){e.v.removeAttribute('src');e.v.load();}
    entries=[];const cards=$('cards');cards.replaceChildren();cards.className='';report('');
    if(view==='single'){
      for(const st of STARTS){
        const r=run(grid[gi],st);if(!r)continue;
        const card=document.createElement('article');card.style.setProperty('--case',colors[st]);
        const cap=document.createElement('div');cap.className='caption';
        cap.innerHTML=`<span>${NAME[st]}</span><span class="stat">τm/τc = ${fmt(r.tm_over_tc)} · late ⟨χ⟩ = ${r.tail_mean.toFixed(3)} · late ⟨m⟩ = ${r.tail_m.toFixed(3)} · Var(χ)/χ̄(1−χ̄) = ${r.tail_binariness.toFixed(3)} · preparation ${fmt(r.preparation_steps/tc)} τc</span>`+
          (r.diagnostic_flags.length?`<span class="flag">${r.diagnostic_flags.join(', ')}</span>`:'');
        card.append(cap);addVideo(r,card,`${NAME[st]}, tau_m ${r.tm_over_tc}: speed, pressure, memory, chi`).style.aspectRatio=`${r.width}/${r.height}`;cards.append(card);
      }
    }else{
      cards.className='grid';cards.style.setProperty('--n',grid.length);
      cards.append(document.createElement('div'));
      grid.forEach((g,k)=>{const h=document.createElement('div');h.className='colhead';const b=document.createElement('button');b.textContent=fmt(g);b.title='Open all four fields';b.onclick=()=>{gi=k;view='single';render();};h.append(b);cards.append(h);});
      for(const st of STARTS){
        const h=document.createElement('div');h.className='rowhead';h.textContent=st==='1'?'active start':'passive start';cards.append(h);
        grid.forEach((g,k)=>{
          const r=run(g,st), box=document.createElement('div');box.className='crop';box.style.setProperty('--case',colors[st]);
          // Only the chi panel of the composite: scale so one native panel fills the square,
          // then shift to the last panel below the header.
          box.style.setProperty('--w',`${100*r.width/P.size}%`);box.style.setProperty('--l',`${-100*P.chi_x/P.size}%`);box.style.setProperty('--t',`${-100*P.header/P.size}%`);
          box.title=`τm/τc = ${fmt(g)}, ${NAME[st]}: late ⟨χ⟩ = ${r.tail_mean.toFixed(3)}`;box.onclick=()=>{gi=k;view='single';render();};
          addVideo(r,box,`chi only, ${NAME[st]}, tau_m ${g}`);cards.append(box);
        });
      }
    }
    bounds();seekTo(old);
    $('view-single').setAttribute('aria-pressed',view==='single');$('view-grid').setAttribute('aria-pressed',view==='grid');
    $('tm-row').style.display=view==='single'?'':'none';
    document.querySelectorAll('#tms button').forEach(b=>b.setAttribute('aria-pressed',+b.dataset.g===gi));
    summary();trace();
  }
  $('hn').textContent=data.law['h-n'];$('wp').textContent=data.law.wp;$('beta').textContent=data.law.beta;$('tchi').textContent=data.law.tau_chi||'—';
  $('mc').textContent=data.mc;$('size').textContent=data.shape.join(' × ');
  grid.forEach((g,i)=>{const b=document.createElement('button');b.dataset.g=i;b.textContent=fmt(g);b.onclick=()=>{gi=i;render();};$('tms').append(b);});
  $('view-single').onclick=()=>{view='single';render();};$('view-grid').onclick=()=>{view='grid';render();};
  $('field').onchange=trace;
  $('play').onclick=()=>playing?stop():play();$('reset').onclick=()=>seekTo(startTime);$('seek').oninput=()=>seekTo(+$('seek').value);
  $('speed').onchange=()=>{if(playing){position=now();pos0=position;wall0=performance.now();}rate=+$('speed').value;sync();};
  $('prep').onchange=()=>{if(!entries.length)return;bounds();trace();seekTo(position);};
  $('fullscreen').hidden=!document.documentElement.requestFullscreen;
  $('fullscreen').onclick=()=>{const a=document.fullscreenElement?document.exitFullscreen():document.documentElement.requestFullscreen();a.catch(err=>report('Full screen unavailable: '+err.message));};
  $('trace').onclick=ev=>{if(!entries.length)return;const b=$('trace').getBoundingClientRect(),x=(ev.clientX-b.left)/b.width*1100,a=lo();seekTo(a+(hi()-a)*(x-64)/1010);};
  timer=setInterval(()=>{
    if(!entries.length)return;
    if(playing){position=Math.min(endTime,now());if(position>=endTime){stop();return;}}
    sync();stamp();
  },150);
  window.addEventListener('pagehide',()=>{stop();clearInterval(timer);});render();
}catch(error){$('notice').textContent='Unable to initialize: '+error.message;console.error(error);}
})();
</script>
</body></html>
